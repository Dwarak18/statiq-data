# ==============================================================================
# STATIQONE Frontend Dockerfile
# Multi-stage: Build with Node 20, serve with Nginx Alpine
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy root frontend package specifications
COPY package*.json ./
RUN npm ci

# Copy root frontend source
COPY . ./

# Build frontend production bundle
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx/nginx.docker.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
