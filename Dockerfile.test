# ==============================================================================
# STATIQONE E2E Test Runner Dockerfile
# Runs: npm test (tsx scripts/verify-e2e.ts)
# No build step — tests read source files directly.
# ==============================================================================

FROM node:20-alpine

WORKDIR /app

# Copy dependency specifications and install (including devDependencies)
COPY package*.json ./
RUN npm ci

# Copy source and test files
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY tsconfig*.json ./
COPY index.html ./

CMD ["npm", "test"]
