# --- Server ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# --- Database ---
DATABASE_URL=postgresql://authuser:authpass@localhost:5432/authdb

# --- JWT (access + refresh) ---
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_hex_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- PII encryption (AES-256-GCM), 32-byte key as 64 hex chars ---
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=replace_with_32_byte_hex_key
# Separate key for the deterministic lookup hash (HMAC-SHA256), 32 bytes hex
# Generate with: openssl rand -hex 32
PII_HMAC_KEY=replace_with_another_32_byte_hex_key

# --- Google OAuth 2.0 ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Microsoft OAuth 2.0 (Azure AD v2 / "Microsoft identity platform") ---
# https://portal.azure.com -> App registrations
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback
# 'common' allows both personal + work/school accounts. Use your tenant ID to restrict.
MICROSOFT_TENANT=common
